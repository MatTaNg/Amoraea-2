{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amoraea.app/schemas/matchmaking-compatibility-result.v1.json",
  "title": "MatchmakingCompatibilityResult",
  "description": "Structured output from AI pairwise compatibility scoring.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eligible",
    "hardBlockReasons",
    "compatibilityScore",
    "compatibilityScoreNormalized",
    "subscores",
    "dealbreakerMultiplier",
    "confidence",
    "strengths",
    "risks",
    "growthEdges",
    "narrativeSummary"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "eligible": { "type": "boolean" },
    "hardBlockReasons": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 12
    },
    "compatibilityScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Display score 0–100."
    },
    "compatibilityScoreNormalized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Final 0–1 score after weighting and dealbreaker multiplier."
    },
    "subscores": {
      "type": "object",
      "required": ["attachment", "values", "style", "semantic"],
      "additionalProperties": false,
      "properties": {
        "attachment": { "type": "number", "minimum": 0, "maximum": 1 },
        "values": { "type": "number", "minimum": 0, "maximum": 1 },
        "style": { "type": "number", "minimum": 0, "maximum": 1 },
        "semantic": { "type": "number", "minimum": 0, "maximum": 1 },
        "sexualCommunicationAdjustment": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 0.1,
          "description": "Soft adjustment: +0.03 if sexual comm means within 0.5, -0.05 if diff > 1.5."
        }
      }
    },
    "dealbreakerMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "strengths": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 },
      "minItems": 2,
      "maxItems": 4
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 },
      "minItems": 2,
      "maxItems": 4
    },
    "growthEdges": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 },
      "minItems": 2,
      "maxItems": 3
    },
    "narrativeSummary": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1200
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    }
  }
}
