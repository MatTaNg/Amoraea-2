{
  "name": "amoraea",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "eas-build-post-install": "node scripts/verify-expo-av-patch.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:lan": "expo start --web --lan",
    "web:tunnel": "expo start --web --tunnel",
    "web:cf-tunnel": "npx --yes cloudflared tunnel --url http://localhost:8081",
    "build:web": "expo export -p web",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",

    "//mobile": "--- Device testing (dev client): build/install ONCE, then start:dev-client each session ---",
    "//start:dev-client": "Daily coding: Metro for installed development builds on phone (Fast Refresh). Not Expo Go.",
    "start:dev-client": "expo start --dev-client",
    "//start:dev-client:tunnel": "Same as start:dev-client when phone cannot reach your PC on local Wi-Fi.",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel",

    "//eas:build:development": "ONE-TIME (or after native/permission/SDK changes): cloud build of the installable development shell for phones.",
    "eas:build:development": "eas build --profile development --platform all",
    "eas:build:development:android": "eas build --profile development --platform android",
    "eas:build:development:ios": "eas build --profile development --platform ios",
    "//eas:build:preview": "Internal test binary (Android APK). Closer to release than development; no Fast Refresh.",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "//eas:build:production": "Store binary (Play AAB / App Store IPA). Use for TestFlight / Play internal / public release QA.",
    "eas:build:production": "eas build --profile production --platform all",
    "eas:build:production:android": "eas build --profile production --platform android",
    "eas:build:production:ios": "eas build --profile production --platform ios",
    "//eas:submit:production": "Upload the latest production build to App Store Connect + Play (internal track per eas.json).",
    "eas:submit:production": "eas submit --profile production --platform all --latest",
    "//eas:update:production": "OTA JS/asset update to production channel — no store review (native changes still need a new build).",
    "eas:update:production": "eas update --channel production --environment production",
    "//eas:update:preview": "OTA JS/asset update to preview channel.",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:maestro": "maestro test maestro",
    "db:push": "supabase db push",
    "db:push:all": "supabase db push --include-all --yes",
    "reprocess-style-labels": "npx tsx --env-file=.env scripts/reprocess-style-labels.node.ts",
    "reprocess-style-labels:deno": "deno run --allow-net --allow-env --allow-read scripts/reprocess-style-labels.ts",
    "reprocess-narrative-conceptual": "npx tsx --env-file=.env scripts/reprocess-narrative-conceptual-from-transcripts.node.ts",
    "reprocess-narrative-conceptual:deno": "deno run --allow-net --allow-env --allow-read scripts/reprocess-narrative-conceptual-from-transcripts.ts",
    "reprocess-moment5-scores": "npx tsx --env-file=.env scripts/reprocess-moment5-scores.ts",
    "score-pair": "npx tsx --env-file=.env scripts/score-pair.ts",
    "score-seed-matrix": "npx tsx --env-file=.env scripts/score-seed-pair-matrix.ts",
    "seed-test-users": "npx tsx --env-file=.env scripts/seedTestUsers.ts",
    "audit-legacy-interview-rescore": "npx tsx --env-file=.env scripts/audit-legacy-interview-rescore.ts",
    "export-threshold-flip-review": "npx tsx --env-file=.env scripts/exportThresholdFlipReview.ts",
    "export-rescore-all-users": "npx tsx --env-file=.env scripts/exportRescoreAllUsers.ts",
    "export-rescore-flip-review": "npx tsx --env-file=.env scripts/exportRescoreFlipReview.ts",
    "verify-report-narrative-grounding": "npx tsx --env-file=.env scripts/verifyReportNarrativeGrounding.ts",
    "rescore-users": "npx tsx --import ./scripts/nodeRnStubs.mjs --env-file=.env scripts/rescoreUsers.ts",
    "flag-scenario-floor-grandfather": "npx tsx --env-file=.env scripts/flag-scenario-floor-grandfather-review.ts",
    "flag-mentalizing-repair-floor-grandfather": "npx tsx --env-file=.env scripts/flag-mentalizing-repair-floor-grandfather-review.ts",
    "backfill:communication-floor": "npx tsx --env-file=.env scripts/backfill-communication-floor-flags.ts",
    "audit-narrative-conceptual-extremes": "deno run --allow-net --allow-env --allow-read scripts/audit-narrative-conceptual-extremes.ts",
    "test:communication-style": "jest --testPathPattern=interviewStyleMarkers --no-cache",
    "deploy:fn:analyze-interview-text": "npx supabase functions deploy analyze-interview-text",
    "deploy:fn:analyze-interview-audio": "npx supabase functions deploy analyze-interview-audio",
    "deploy:fn:admin-delete-user": "npx supabase functions deploy admin-delete-user",
    "deploy:fn:admin-fetch-dating-profile-data": "npx supabase functions deploy admin-fetch-dating-profile-data",
    "deploy:fn:anthropic-proxy": "npx supabase functions deploy anthropic-proxy",
    "deploy:fn:process-personality-document": "npx supabase functions deploy process-personality-document",
    "deploy:fn:ai-reasoning": "npx supabase functions deploy anthropic-proxy admin-retry-ai-reasoning complete-standard-interview retry-pending-ai-reasoning process-deferred-standard-interviews",
    "deploy:fn:communication-style": "npx supabase functions deploy analyze-interview-text && npx supabase functions deploy analyze-interview-audio"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.1",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "libphonenumber-js": "^1.12.41",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.49.2",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "latest",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.33.5",
    "supabase": "^2.84.7",
    "typescript": "^5.3.3"
  },
  "private": true
}
